rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Verify authenticated session
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isAuthenticated() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    // Active user check: blocks Suspended and Deleted/Revoked accounts at the database layer
    function isActiveUser() {
      return userExists() && !(userData().get('status', 'Active') in ['Suspended', 'Deleted']);
    }

    function normalizedRole() {
      return userData().role == 'Store Keeper' ? 'Storekeeper' : userData().role;
    }

    function isAdmin() {
      return isActiveUser() && normalizedRole() == 'System Administrator';
    }

    function isGM() {
      return isActiveUser() && normalizedRole() == 'General Manager';
    }

    function isAdminOrGM() {
      return isAdmin() || isGM();
    }

    function isStorekeeper() {
      return isActiveUser() && normalizedRole() == 'Storekeeper';
    }

    function isPurchasing() {
      return isActiveUser() && normalizedRole() == 'Purchasing';
    }

    function permsPath() {
      return /databases/$(database)/documents/settings/permissions;
    }

    // Honors dynamic role permissions stored in settings/permissions while falling back cleanly
    // for new v3.5 permissions (like manage_vendors) introduced after an older matrix was saved.
    function hasPerm(perm, defaultAllowed) {
      return isAdmin() || (
        isActiveUser() && (
          exists(permsPath()) &&
          (normalizedRole() in get(permsPath()).data) &&
          (perm != 'manage_vendors' || ('manage_vendors' in get(permsPath()).data.get('System Administrator', [])))
            ? (perm in get(permsPath()).data[normalizedRole()])
            : defaultAllowed
        )
      );
    }

    // users:
    // - Self can read own profile; privileged staff & admins can read directory for filters/audit.
    // - First-time self-bootstrap allowed only when no user document exists yet, strictly as active 'User'.
    // - Deleted or Suspended accounts cannot overwrite or resurrect themselves.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        userId == request.auth.uid ||
        isAdmin() ||
        hasPerm('manage_users', false) ||
        hasPerm('view_all_requests', isGM() || isPurchasing() || isStorekeeper()) ||
        hasPerm('view_reports', isGM() || isPurchasing())
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (hasPerm('manage_users', false) && request.resource.data.role != 'System Administrator') ||
        (userId == request.auth.uid &&
         !exists(/databases/$(database)/documents/users/$(userId)) &&
         (!('role' in request.resource.data) || request.resource.data.role == 'User') &&
         request.resource.data.get('status', 'Active') == 'Active')
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (hasPerm('manage_users', false) &&
         resource.data.role != 'System Administrator' &&
         request.resource.data.role != 'System Administrator') ||
        (isActiveUser() &&
         userId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'department', 'status', 'deletedAt', 'deletedBy']))
      );
      allow delete: if isAdmin();
    }

    // requests:
    // - Users without view_all_requests can only read their own requests.
    // - Create strictly as Pending owned by creator with >= 1 item and non-negative cost.
    // - Role-isolated state transitions + immutable header/line-item fields on approval/order.
    match /requests/{requestId} {
      allow read: if isActiveUser() && (
        resource.data.createdBy == request.auth.uid ||
        hasPerm('view_all_requests', isGM() || isPurchasing() || isStorekeeper()) ||
        hasPerm('approve_requests', isGM()) ||
        hasPerm('manage_inventory', isStorekeeper()) ||
        hasPerm('view_reports', isGM() || isPurchasing())
      );
      allow create: if isAdmin() || (
        isActiveUser() &&
        hasPerm('create_request', true) &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.totalCost is number &&
        request.resource.data.totalCost >= 0
      );
      allow update: if isActiveUser() && (
        isAdmin() ||
        // GM (or permitted role): approve or reject only Pending requests without altering items/cost/creator
        (hasPerm('approve_requests', isGM()) &&
         resource.data.status == 'Pending' &&
         request.resource.data.status in ['Approved', 'Rejected'] &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdByEmail', 'createdAt', 'items', 'totalCost', 'department', 'requestType'])) ||
        // Purchasing: place vendor order only on Approved POs without altering items/cost/creator
        (isPurchasing() &&
         resource.data.status == 'Approved' &&
         request.resource.data.status == 'Ordered' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdByEmail', 'createdAt', 'items', 'totalCost', 'department', 'requestType'])) ||
        // Storekeeper (or manage_inventory): issue requisition or receive PO goods
        (hasPerm('manage_inventory', isStorekeeper()) &&
         request.resource.data.status in ['Issued', 'Partially Issued', 'Received', 'Partially Received'] &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdByEmail', 'createdAt', 'totalCost', 'department', 'requestType']))
      );
      allow delete: if isAdmin();
    }

    // inventory: active staff can read catalog for requisitions; only inventory managers write
    match /inventory/{itemId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser() && hasPerm('manage_inventory', isStorekeeper());
    }

    // stock_movements: audit ledger — strictly append-only (update/delete permanently denied)
    match /stock_movements/{movementId} {
      allow read: if isActiveUser() && (
        hasPerm('manage_inventory', isStorekeeper()) ||
        hasPerm('view_reports', isGM() || isPurchasing()) ||
        isGM()
      );
      allow create: if isActiveUser() &&
        hasPerm('manage_inventory', isStorekeeper()) &&
        request.resource.data.type in ['IN', 'OUT'] &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity >= 0;
      allow update, delete: if false;
    }

    // budgets: restricted to budget managers (GM / Admin or custom permission)
    match /budgets/{budgetId} {
      allow read, write: if isActiveUser() && hasPerm('manage_budgets', isGM());
    }

    // departments & settings: readable by active users, writable by settings managers
    match /departments/{deptId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser() && hasPerm('manage_settings', isGM());
    }

    // vendors: approved supplier directory
    match /vendors/{vendorId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() && hasPerm('manage_vendors', isPurchasing() || isGM());
      allow delete: if isAdminOrGM();
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || (isActiveUser() && settingId != 'backup');
      allow write: if isAdmin() || (isActiveUser() && hasPerm('manage_settings', isGM()) && settingId != 'backup');
    }

    // backups: sensitive backup metadata & Cloudinary config strictly restricted to Admins
    match /backups/{docId} {
      allow read, write: if isAdmin();
    }

    // notifications: active staff can read/create; updates strictly limited to marking 'readBy'
    match /notifications/{notificationId} {
      allow read, create: if isActiveUser();
      allow update: if isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isAdminOrGM();
    }
  }
}
